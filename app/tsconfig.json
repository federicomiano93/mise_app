{
  "compilerOptions": {
    // The oldest browsers Mise 2 must run on: the lab tablet SM-T550 (Chrome 101, the newest Google Play serves it) and
    // iPhone Safari 16.4. ES2022 is fully supported by both, so nothing is polyfilled.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    // vite.config.ts imports ./build-version.ts with its extension: that is what Vite's native
    // config loader (the future default) can resolve. Allowed only because nothing is emitted.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
