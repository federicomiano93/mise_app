{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(node --check:*)",
      "Bash(npx serve:*)",
      "Bash(npx --yes serve:*)",
      "Bash(npx http-server:*)",
      "Bash(npx --yes http-server:*)",
      "Bash(python -m http.server:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git push origin feature/:*)",
      "Bash(git push -u origin feature/:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-admin-sdk.mjs\"; [ -f \"$f\" ] || exit 0; exec node \"C:/Users/feder/.claude/run-guard.mjs\" \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
