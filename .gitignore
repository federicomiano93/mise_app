firebase-config.js
# js/firebase.js is intentionally committed so GitHub Pages can serve it.
# The Firebase web config is public by design; the API key is restricted to
# the app domain in Google Cloud Console. Do not re-add it to .gitignore.
.env
# ⚠️ THE ANTHROPIC API KEY LIVES HERE WHEN THE EMULATOR RUNS, AND IT IS A REAL
# SECRET — not public config like js/firebase.js. `firebase functions:secrets:set`
# and `firebase emulators:start` both write functions/.secret.local, and this repo
# is PUBLIC. These two lines exist BEFORE the first secrets command was ever run,
# on purpose: a key committed here would be readable by anyone and chargeable to
# the account until somebody noticed.
.secret.local
functions/.secret.local
# The variants of .env that tools write beside it (Vite, Firebase, dotenv): `.env` alone
# matches only the bare name, so `.env.local` would have been committed. An example file
# is the one allowed (P7).
.env.*
!.env.example
# Server-level credentials (P1): private keys and certificates, and the service-account
# JSON the Firebase console downloads (`<project>-firebase-adminsdk-<id>.json`). None of
# them is ever needed in here — CI signs in to Google through Workload Identity.
*.pem
*.key
*.p12
*.pfx
*-firebase-adminsdk-*.json
service-account*.json
serviceAccount*.json
# The credentials file google-github-actions/auth writes into the checkout during a CI
# job (tests/preview-hosting.test.mjs tells the story of the time one nearly went public).
gha-creds-*.json
node_modules/
# CLAUDE.md (project context) and CLAUDE.global.md (transport copy of the global
# rules) stay local and must never be committed or published.
CLAUDE*.md
# One-off artifacts for the git-history client-name scrub (local only)
history-name-replacements.txt
*.bundle
# Firebase Emulator Suite local artifacts (generated when emulators run locally)
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
# Claude Code: local machine-specific settings stay private; the shared
# .claude/settings.json (permissions allow/deny) is committed on purpose.
.claude/settings.local.json

# Local notes split out of the (gitignored) CLAUDE.md — same rules apply: never committed.
STORICO-DEPLOY.md
ARCHIVIO-BACKLOG.md

# ⚠️ THE PRINT AGENT'S CREDENTIALS. They belong in %LOCALAPPDATA%\Mise\, never in
# here — everything in this repository is served by GitHub Pages, so a password
# committed beside the code would be published on the web. print-agent/README.md
# says so and tests/print-agent.test.mjs fails if the file ever appears; this line
# is the third belt, because the cost of the mistake is somebody else's database.
print-agent/print-agent.json

# Staged by .github/workflows/preview.yml for a preview channel; never committed.
_site/

# Mise 2's build output: built by CI from app/, never committed (unlike the current app's
# root dist/, which GitHub Pages serves and which therefore IS committed — hence the anchor).
/app/dist/
*.tsbuildinfo

# ⚠️ INVOICE IMPORT (3 Oct 2026): real invoices, the decisions workbook and the import
# file hold real supplier names and prices, and this repository is public and served by
# GitHub Pages. They live in ..\import-fatture\, outside the repo; these lines are the
# second belt in case one is ever saved in here by mistake. The test fixtures are
# invented and live under invoice-import/tests/fixtures/ as .xml, which stays allowed.
*.xlsx
*.p7m
*.zip
mise-import-*.json
invoice-import/config.json
__pycache__/
*.pyc
